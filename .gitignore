# ==============================================================================
# ChessBoard — Root .gitignore
# ==============================================================================

# --- macOS / OS Files ---
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db

# --- Godot 4+ (chessboard) ---
.godot/
chessboard/.godot/
chessboard/android/
*.translation

# --- Android & Gradle (godot-webview) ---
.gradle/
**/.gradle/
**/build/
local.properties
**/local.properties
*.iml
.cxx/
.externalNativeBuild/
captures/

# --- IDEs & Editors ---
.idea/
**/.idea/
.vscode/
**/.vscode/
*.swp
*.swo
*~

# --- Local Environment Overrides ---
.env
.env.local
.env.*.local

# --- Packaged Binaries & Signing Keys ---
*.apk
*.aab
*.ap_
*.dex
*.keystore
*.jks

# Keep compiled plugin & Board SDK AARs inside chessboard/addons/
!chessboard/addons/**/*.aar
