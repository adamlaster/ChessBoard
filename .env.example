# ==============================================================================
# Chess 4 Board - Local Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' or '.env.local' to customize paths for your machine.
# If omitted or left commented out, 'build_and_deploy.sh' will automatically
# detect standard macOS / Homebrew / Android Studio locations.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Android SDK
# ------------------------------------------------------------------------------
# Path to your Android SDK installation (requires platform-tools and build-tools).
# Default (macOS): $HOME/Library/Android/sdk
# Default (Linux): $HOME/Android/Sdk
# ANDROID_HOME="$HOME/Library/Android/sdk"

# ------------------------------------------------------------------------------
# 2. Java Development Kit (JDK 17+)
# ------------------------------------------------------------------------------
# Path to Java 17+ JDK.
# Default (macOS Homebrew): /opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home
# Default (Android Studio JBR): /Applications/Android Studio.app/Contents/jbr/Contents/Home
# JAVA_HOME="/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home"

# ------------------------------------------------------------------------------
# 3. Godot Engine Binary (Godot 4.2+)
# ------------------------------------------------------------------------------
# Path to the Godot 4 executable used to run headless Android exports.
# Default (macOS GUI App): /Applications/Godot.app/Contents/MacOS/Godot
# Default (CLI/Homebrew): 'godot' or 'godot4' on PATH
# GODOT_BIN="/Applications/Godot.app/Contents/MacOS/Godot"

# ------------------------------------------------------------------------------
# 4. Export Output Directory & APK Filename
# ------------------------------------------------------------------------------
# Destination folder where the exported Chess4Board.apk is placed.
# By default, this points to a sibling directory '../output' to keep large 90+ MB
# binary artifacts strictly outside git version control.
# OUTPUT_DIR="../output"
# APK_NAME="Chess4Board.apk"

# ------------------------------------------------------------------------------
# 5. Board Hardware Deployment (board-connect CLI)
# ------------------------------------------------------------------------------
# Path to the board-connect utility used to install and launch on the Board display.
# Default: ~/.local/bin/board-connect or 'board-connect' on PATH
# BOARD_CONNECT_BIN="$HOME/.local/bin/board-connect"

# Optional: Custom arguments or target IP address for board-connect
# BOARD_CONNECT_ARGS=""
